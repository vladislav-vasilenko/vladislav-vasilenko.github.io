{
    "manifest_version": 3,
    "name": "JobAutoFill Magic · Workday",
    "version": "1.1.1",
    "description": "Legacy Workday experience importer. Corporate applications use ML Research Vacancy Search and the local Career service.",
    "permissions": [
        "storage",
        "activeTab",
        "scripting",
        "contextMenus"
    ],
    "host_permissions": [
        "https://vladislav-vasilenko-github-io.vercel.app/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkdaysite.com/*",
        "https://*.workday.com/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "128": "icons/icon128.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://*.myworkdayjobs.com/*",
                "https://*.myworkdaysite.com/*",
                "https://*.workday.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_idle"
        }
    ]
}
