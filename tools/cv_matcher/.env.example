# Copy to .env (same folder) and fill in locally. Names only here; values never
# enter git. The index is checked by `npm run workspace:check`; see docs/security.md.

# --- Local service (resume_import_server.py, port 8788) ---
OPENAI_API_KEY=
# Optional model/provider overrides (defaults are in code)
COVER_LETTER_MODEL=
OPENAI_EMBEDDING_MODEL=
EMBEDDINGS_PROVIDER=
OLLAMA_HOST=
OLLAMA_EMBEDDING_MODEL=

# --- Google Calendar OAuth (Web application client); tokens land in .cache/calendar/oauth.json
# Redirect URI: http://127.0.0.1:8788/archive/calendar/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# --- Telegram control bot and optional Telethon userbot (see telegram.env.example) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_USERNAME=
TELEGRAM_DIGEST_TIMES=
TELEGRAM_DIGEST_TIMEZONE=

# --- Legacy RAG matcher client (cv_matcher.py -> cv-api on Vercel); not used by the 8788 service ---
CV_API_URL=
API_SECRET=

# --- CI-only scraper flags (set as GitHub Actions secrets/env, not here) ---
# GOOGLE_STORAGE_STATE, META_STORAGE_STATE, LINKEDIN_STORAGE_STATE, INDEED_STORAGE_STATE,
# WELLFOUND_STORAGE_STATE, ENABLE_SBER_SCRAPER

# LINKEDIN_LI_AT / LINKEDIN_EMAIL / LINKEDIN_PASSWORD were read only by the legacy
# scripts/scrape_linkedin.py. Remove them from .env; the current LinkedIn section
# of the Chrome extension reads the already open, logged-in tab instead.
