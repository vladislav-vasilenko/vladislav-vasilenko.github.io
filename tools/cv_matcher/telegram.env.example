# Append these entries to your private .env; never send credentials in chat.
# Obtain API ID/hash at https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Token of YOUR operator bot from @BotFather (not giga_recruiter_bot)
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID; must match the Telethon account
TELEGRAM_OWNER_ID=
# Optional; defaults match this project
TELEGRAM_BOT_USERNAME=baniartbot
TELEGRAM_DIGEST_TIMES=10:00,19:00
TELEGRAM_DIGEST_TIMEZONE=Europe/Moscow
